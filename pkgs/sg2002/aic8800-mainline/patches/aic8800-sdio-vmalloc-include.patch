+++ b/src/SDIO/driver_fw/driver/aic8800/aic8800_fdrv/aic_priv_cmd.c
@@ -12,6 +12,7 @@
 
 #include <linux/netdevice.h>
 #include <linux/ctype.h>
+#include <linux/vmalloc.h>
 #include "rwnx_defs.h"
 #include "rwnx_msg_tx.h"
 #include "rwnx_debugfs.h"
