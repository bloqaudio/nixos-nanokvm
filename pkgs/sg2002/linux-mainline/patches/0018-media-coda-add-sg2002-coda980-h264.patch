+static bool coda_firmware_name_valid(const char *name)
+{
+	const char *component = name;
+	size_t len;
+
+	if (!name || !*name || name[0] == '/' || strnlen(name, 256) == 256)
+		return false;
+
+	while (*component) {
+		len = strcspn(component, "/");
+		if (!len || (len == 1 && component[0] == '.') ||
+		    (len == 2 && component[0] == '.' && component[1] == '.'))
+			return false;
+
+		component += len;
+		if (!*component)
+			break;
+		component++;
+		if (!*component)
+			return false;
+	}
+
+	return true;
+}
