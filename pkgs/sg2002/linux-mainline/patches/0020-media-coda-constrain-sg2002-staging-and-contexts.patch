From 9a2e379ee649ec7de5bdfeb727d0a8b1e9ed02cb Mon Sep 17 00:00:00 2001
From: George Whewell <georgerw@gmail.com>
Date: Sun, 9 Aug 2026 14:55:04 +0200
Subject: [PATCH] media: coda: constrain SG2002 staging and contexts

Tighten three SG2002 bring-up details:

- The NV21 staging buffer is allocated coherent, so the
  dma_sync_single_for_device() at the end of coda_stage_nv21() is
  redundant; drop it.
- The CAPTURE queue's io_modes have no reason to depend on the INPUT
  staging path; advertise VB2_DMABUF | VB2_MMAP uniformly.
- The SG2002 firmware handles a single encoder context. Honour the
  devtype max_instances limit in coda_open() instead of relying on
  the CODA_DX6 special case, so the SG2002 cap of one context is
  enforced.

Signed-off-by: George Whewell <georgerw@gmail.com>
---
 drivers/media/platform/chips-media/coda/coda-bit.c    | 3 ---
 drivers/media/platform/chips-media/coda/coda-common.c | 9 ++++-----
 2 files changed, 4 insertions(+), 8 deletions(-)

diff --git a/drivers/media/platform/chips-media/coda/coda-bit.c b/drivers/media/platform/chips-media/coda/coda-bit.c
index b844dd006..7af119719 100644
--- a/drivers/media/platform/chips-media/coda/coda-bit.c
+++ b/drivers/media/platform/chips-media/coda/coda-bit.c
@@ -1526,9 +1526,6 @@ static int coda_stage_nv21(struct coda_ctx *ctx,
 		dst[luma_size + i + 1] = src[luma_size + i];
 	}
 
-	dma_sync_single_for_device(ctx->dev->dev, staging->paddr, size,
-				   DMA_TO_DEVICE);
-
 	return 0;
 }
 
diff --git a/drivers/media/platform/chips-media/coda/coda-common.c b/drivers/media/platform/chips-media/coda/coda-common.c
index 180200aff..028a0c9e0 100644
--- a/drivers/media/platform/chips-media/coda/coda-common.c
+++ b/drivers/media/platform/chips-media/coda/coda-common.c
@@ -2646,10 +2646,7 @@ int coda_encoder_queue_init(void *priv, struct vb2_queue *src_vq,
 		return ret;
 
 	dst_vq->type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
-	if (ctx->dev->devtype->nv21_to_nv12)
-		dst_vq->io_modes = VB2_MMAP;
-	else
-		dst_vq->io_modes = VB2_DMABUF | VB2_MMAP;
+	dst_vq->io_modes = VB2_DMABUF | VB2_MMAP;
 	dst_vq->mem_ops = &vb2_dma_contig_memops;
 
 	return coda_queue_init(priv, dst_vq);
@@ -2694,7 +2691,9 @@ static int coda_open(struct file *file)
 	if (!ctx)
 		return -ENOMEM;
 
-	if (dev->devtype->product == CODA_DX6)
+	if (dev->devtype->max_instances)
+		max = dev->devtype->max_instances - 1;
+	else if (dev->devtype->product == CODA_DX6)
 		max = CODADX6_MAX_INSTANCES - 1;
 	idx = ida_alloc_max(&dev->ida, max, GFP_KERNEL);
 	if (idx < 0) {
-- 
