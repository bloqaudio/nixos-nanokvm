From f6f1466797a66109fda519c465530644f8c272e9 Mon Sep 17 00:00:00 2001
From: George Whewell <georgerw@gmail.com>
Date: Sun, 9 Aug 2026 14:51:44 +0200
Subject: [PATCH] media: coda: keep Coda980 firmware ID out of ABI enum

The Coda980 firmware reports product code 0x9800 through the version
query, but that value names the firmware product, not the register
command ABI: the SG2002 core implements the Coda9 command set and is
driven through the existing Coda960 platform data. Putting 0x9800 in
enum coda_product claims a third ABI variant that does not exist.

Replace the enum member with a plain CODA980_PRODUCT_CODE define and
make coda_devtype::firmware_product a u16, keeping enum coda_product
for register ABIs only. No functional change.

Signed-off-by: George Whewell <georgerw@gmail.com>
---
 drivers/media/platform/chips-media/coda/coda-common.c | 4 ++--
 drivers/media/platform/chips-media/coda/coda.h        | 4 ++--
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/drivers/media/platform/chips-media/coda/coda-common.c b/drivers/media/platform/chips-media/coda/coda-common.c
index e3281dfea..180200aff 100644
--- a/drivers/media/platform/chips-media/coda/coda-common.c
+++ b/drivers/media/platform/chips-media/coda/coda-common.c
@@ -444,7 +444,7 @@ const char *coda_product_name(int product)
 		return "CODA7541";
 	case CODA_960:
 		return "CODA960";
-	case CODA_980:
+	case CODA980_PRODUCT_CODE:
 		return "CODA980";
 	default:
 		snprintf(buf, sizeof(buf), "(0x%04x)", product);
@@ -3321,7 +3321,7 @@ static const struct coda_devtype coda_devdata[] = {
 static const struct coda_devtype sg2002_coda980_devdata = {
 	/* The SG2002 firmware implements the Coda9 register command ABI. */
 	.product		= CODA_960,
-	.firmware_product	= CODA_980,
+	.firmware_product	= CODA980_PRODUCT_CODE,
 	.codecs			= coda9_codecs,
 	.num_codecs		= ARRAY_SIZE(coda9_codecs),
 	.vdevs			= sg2002_coda980_video_devices,
diff --git a/drivers/media/platform/chips-media/coda/coda.h b/drivers/media/platform/chips-media/coda/coda.h
index 60ef7fd0f..ad34a3d76 100644
--- a/drivers/media/platform/chips-media/coda/coda.h
+++ b/drivers/media/platform/chips-media/coda/coda.h
@@ -29,6 +29,7 @@
 #define CODA_MAX_FRAMEBUFFERS	19
 #define FMO_SLICE_SAVE_BUF_SIZE	(32)
 #define CODA_PARA_BUF_SIZE	(10 * 1024)
+#define CODA980_PRODUCT_CODE	0x9800
 
 /*
  * This control allows applications to read the per-stream
@@ -52,7 +53,6 @@ enum coda_product {
 	CODA_HX4 = 0xf00a,
 	CODA_7541 = 0xf012,
 	CODA_960 = 0xf020,
-	CODA_980 = 0x9800,
 };
 
 struct coda_video_device;
@@ -63,7 +63,7 @@ struct coda_devtype {
 	/* Product implementing the register ABI used by this driver. */
 	enum coda_product	product;
 	/* Optional product value returned by the firmware query command. */
-	enum coda_product	firmware_product;
+	u16			firmware_product;
 	const struct coda_codec	*codecs;
 	unsigned int		num_codecs;
 	const struct coda_video_device **vdevs;
-- 
2.54.0

