From 6799d8e51dbb909138be7022481f21795ec9a475 Mon Sep 17 00:00:00 2001
From: Codex SG2002 port <codex@localhost>
Date: Sun, 9 Aug 2026 15:05:06 +0200
Subject: [PATCH] media: coda: support SG2002 NV12 and DMA-BUF input

Allow zero-copy NV12 INPUT buffers on the SG2002 Coda980 encoder. Convert
NV21 INPUT through a coherent staging buffer; imported DMA-BUFs are explicitly
CPU-mapped for the chroma-order conversion. Keep H.264 CAPTURE MMAP-only for
now because Coda header generation writes the destination buffer on the CPU.

Signed-off-by: Codex SG2002 port <codex@localhost>
---
 .../platform/chips-media/coda/coda-bit.c      | 62 ++++++++++++++++---
 .../platform/chips-media/coda/coda-common.c   | 13 ++--
 2 files changed, 61 insertions(+), 14 deletions(-)

diff --git a/drivers/media/platform/chips-media/coda/coda-bit.c b/drivers/media/platform/chips-media/coda/coda-bit.c
index 7af119719..b320a36b4 100644
--- a/drivers/media/platform/chips-media/coda/coda-bit.c
+++ b/drivers/media/platform/chips-media/coda/coda-bit.c
@@ -10,7 +10,9 @@
 
 #include <linux/clk.h>
 #include <linux/delay.h>
+#include <linux/dma-buf.h>
 #include <linux/dma-mapping.h>
+#include <linux/iosys-map.h>
 #include <linux/irqreturn.h>
 #include <linux/kernel.h>
 #include <linux/log2.h>
@@ -1059,6 +1061,7 @@ static int coda_encoder_reqbufs(struct coda_ctx *ctx,
 		if (ret < 0)
 			return ret;
 		if (ctx->dev->devtype->nv21_to_nv12 &&
+		    q_data_src->fourcc == V4L2_PIX_FMT_NV21 &&
 		    !ctx->input_staging.vaddr) {
 			ret = coda_alloc_context_buf(ctx, &ctx->input_staging,
 					     q_data_src->sizeimage,
@@ -1499,10 +1502,16 @@ static int coda_stage_nv21(struct coda_ctx *ctx,
 {
 	struct coda_aux_buf *staging = &ctx->input_staging;
 	struct vb2_buffer *vb = &src_buf->vb2_buf;
+	struct dma_buf *dbuf = vb->planes[0].dbuf;
+	struct iosys_map map = IOSYS_MAP_INIT_VADDR(NULL);
 	u8 *src, *dst;
 	size_t chroma_size, i, luma_size, size;
+	bool mapped = false;
+	bool cpu_access = false;
+	int ret;
 
-	if (!ctx->dev->devtype->nv21_to_nv12)
+	if (!ctx->dev->devtype->nv21_to_nv12 ||
+	    q_data->fourcc != V4L2_PIX_FMT_NV21)
 		return 0;
 	if (!staging->vaddr || !q_data->bytesperline || !q_data->height)
 		return -EINVAL;
@@ -1515,18 +1524,53 @@ static int coda_stage_nv21(struct coda_ctx *ctx,
 	    size > vb2_get_plane_payload(vb, 0))
 		return -EINVAL;
 
-	src = vb2_plane_vaddr(vb, 0);
-	if (!src)
-		return -EFAULT;
-
 	dst = staging->vaddr;
-	memcpy(dst, src, luma_size);
+	if (vb->memory == VB2_MEMORY_DMABUF) {
+		/*
+		 * vb2 maps imported DMA-BUFs for the codec DMA address, but
+		 * NV21 needs a CPU VU-to-UV conversion before this encoder can
+		 * consume it. Bracket our separate CPU mapping explicitly.
+		 */
+		if (!dbuf)
+			return -EINVAL;
+
+		ret = dma_buf_begin_cpu_access(dbuf, DMA_FROM_DEVICE);
+		if (ret)
+			return ret;
+		cpu_access = true;
+
+		ret = dma_buf_vmap_unlocked(dbuf, &map);
+		if (ret)
+			goto out_cpu_access;
+		mapped = true;
+		iosys_map_memcpy_from(dst, &map, 0, size);
+	} else {
+		src = vb2_plane_vaddr(vb, 0);
+		if (!src)
+			return -EFAULT;
+		memcpy(dst, src, size);
+	}
+
 	for (i = 0; i < chroma_size; i += 2) {
-		dst[luma_size + i] = src[luma_size + i + 1];
-		dst[luma_size + i + 1] = src[luma_size + i];
+		u8 chroma = dst[luma_size + i];
+
+		dst[luma_size + i] = dst[luma_size + i + 1];
+		dst[luma_size + i + 1] = chroma;
+	}
+
+	ret = 0;
+out_cpu_access:
+	if (mapped)
+		dma_buf_vunmap_unlocked(dbuf, &map);
+	if (cpu_access) {
+		int end_ret;
+
+		end_ret = dma_buf_end_cpu_access(dbuf, DMA_FROM_DEVICE);
+		if (!ret)
+			ret = end_ret;
 	}
 
-	return 0;
+	return ret;
 }
 
 static int coda_prepare_encode(struct coda_ctx *ctx)
diff --git a/drivers/media/platform/chips-media/coda/coda-common.c b/drivers/media/platform/chips-media/coda/coda-common.c
index e15185341..ac460644b 100644
--- a/drivers/media/platform/chips-media/coda/coda-common.c
+++ b/drivers/media/platform/chips-media/coda/coda-common.c
@@ -340,6 +340,7 @@ static const struct coda_video_device sg2002_coda980_encoder = {
 	.type = CODA_INST_ENCODER,
 	.ops = &coda_bit_encode_ops,
 	.src_formats = {
+		V4L2_PIX_FMT_NV12,
 		V4L2_PIX_FMT_NV21,
 	},
 	.dst_formats = {
@@ -2635,10 +2636,7 @@ int coda_encoder_queue_init(void *priv, struct vb2_queue *src_vq,
 	int ret;
 
 	src_vq->type = V4L2_BUF_TYPE_VIDEO_OUTPUT;
-	if (ctx->dev->devtype->nv21_to_nv12)
-		src_vq->io_modes = VB2_MMAP;
-	else
-		src_vq->io_modes = VB2_DMABUF | VB2_MMAP;
+	src_vq->io_modes = VB2_DMABUF | VB2_MMAP;
 	src_vq->mem_ops = &vb2_dma_contig_memops;
 
 	ret = coda_queue_init(priv, src_vq);
@@ -2646,7 +2644,11 @@ int coda_encoder_queue_init(void *priv, struct vb2_queue *src_vq,
 		return ret;
 
 	dst_vq->type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
-	dst_vq->io_modes = VB2_DMABUF | VB2_MMAP;
+	/* H.264 header generation writes the capture buffer on the CPU. */
+	if (ctx->dev->devtype->nv21_to_nv12)
+		dst_vq->io_modes = VB2_MMAP;
+	else
+		dst_vq->io_modes = VB2_DMABUF | VB2_MMAP;
 	dst_vq->mem_ops = &vb2_dma_contig_memops;
 
 	return coda_queue_init(priv, dst_vq);
@@ -3645,3 +3647,4 @@ module_platform_driver(coda_driver);
 MODULE_LICENSE("GPL");
 MODULE_AUTHOR("Javier Martin <javier.martin@vista-silicon.com>");
 MODULE_DESCRIPTION("Coda multi-standard codec V4L2 driver");
+MODULE_IMPORT_NS("DMA_BUF");
