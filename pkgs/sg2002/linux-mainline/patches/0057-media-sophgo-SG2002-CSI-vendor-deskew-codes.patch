From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: George Whewell <georgerw@gmail.com>
Date: Thu, 27 Aug 2026 01:40:00 +0200
Subject: [PATCH 0057] media: sophgo: SG2002 CSI capture: tune RAW lane setup

The GC4653 uses two physical data lanes. Match the vendor cif driver in
the two places where the RAW path differs from the established four-lane
LT6911 HDMI setup:

- the vendor leaves the REG_80 clock-invert bits clear (they are only
  flipped through its output-clk-edge ioctl; we set all six);
- the vendor enables only (1 << lane_num) - 1 deskew lanes at stream
  start (we enabled all four).

Keep the vendor Linux driver's default deskew phases: clock 0x00, near
data 0x03, far data 0x08. The freertos tree carries board-specific
lane_phase overrides and is not evidence for changing those defaults.
The registers are clocked only while capture is active; select the setup
at stream-on time.
---
--- a/drivers/media/platform/sophgo/sg2002-capture.c
+++ b/drivers/media/platform/sophgo/sg2002-capture.c
@@ -525,14 +525,16 @@
 		sg2002_set_deskew(cap, i, phase);
 	}
 
-	/* D-PHY mode, fixed settle time, no automatic deskew. */
+	/* The RAW path follows the vendor driver's clear clock-invert bits;
+	 * preserve the established HDMI value. */
 	sg2002_update_bits(cap->wrap, WRAP_PHY4_MODE, GENMASK(1, 0), 0);
 	sg2002_update_bits(cap->wrap, WRAP_PHY4_HS_SETTLE,
 			    WRAP_PHY4_SETTLE | WRAP_PHY4_AUTO_IGNORE |
 			    WRAP_PHY4_AUTO_SYNC,
 			    FIELD_PREP(WRAP_PHY4_SETTLE, SG2002_HS_SETTLE));
-	sg2002_update_bits(cap->wrap, WRAP_TOP_DESKEW_FORCE,
-			    WRAP_TOP_CLOCK_INVERT, WRAP_TOP_CLOCK_INVERT);
+	sg2002_update_bits(cap->wrap, WRAP_TOP_DESKEW_FORCE,
+			    WRAP_TOP_CLOCK_INVERT,
+			    cap->yuv_input ? WRAP_TOP_CLOCK_INVERT : 0);
 }
 
 static void sg2002_csi_enable(struct sg2002_capture *cap, bool enable)
@@ -578,9 +582,12 @@
 			    WRAP_PHY4_DESKEW_LANES, 0);
 	sg2002_update_bits(cap->wrap, WRAP_TOP_POWER, WRAP_TOP_PD_RXLP, 0);
 	udelay(20);
+	/* RAW follows vendor cif_stream_enable(); HDMI keeps all four. */
 	sg2002_update_bits(cap->wrap, WRAP_PHY4_LANE_ENABLE,
 			    WRAP_PHY4_DESKEW_LANES,
-			    FIELD_PREP(WRAP_PHY4_DESKEW_LANES, 0xf));
+			    FIELD_PREP(WRAP_PHY4_DESKEW_LANES,
+				       cap->yuv_input ? 0xf :
+				       (1 << cap->bus.num_data_lanes) - 1));
 }
 
 static void sg2002_dma_set_addr(struct sg2002_capture *cap, dma_addr_t addr)
