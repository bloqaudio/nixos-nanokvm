From 52c92b2491a145c871037fd9a5586b0547434cb7 Mon Sep 17 00:00:00 2001
From: Codex SG2002 port <codex@localhost>
Date: Sun, 9 Aug 2026 15:40:28 +0200
Subject: [PATCH] media: coda: read SG2002 product code from GDI

Coda980 returns a customer code in the upper half of the firmware version word. Its hardware product code is instead exposed by the GDI product register at offset 0x1044.

Let platform data select that register and validate the observed 3.0.1 firmware against CODA980 without changing the existing Coda firmware ABI.
---
 drivers/media/platform/chips-media/coda/coda-bit.c    | 11 ++++++++---
 drivers/media/platform/chips-media/coda/coda-common.c |  1 +
 drivers/media/platform/chips-media/coda/coda.h        |  2 ++
 drivers/media/platform/chips-media/coda/coda_regs.h   |  1 +
 4 files changed, 12 insertions(+), 3 deletions(-)

diff --git a/drivers/media/platform/chips-media/coda/coda-bit.c b/drivers/media/platform/chips-media/coda/coda-bit.c
index 55480652e..0f5d122b1 100644
--- a/drivers/media/platform/chips-media/coda/coda-bit.c
+++ b/drivers/media/platform/chips-media/coda/coda-bit.c
@@ -939,6 +939,7 @@ static u32 coda_supported_firmwares[] = {
 	CODA_FIRMWARE_VERNUM(CODA_960, 2, 1, 9),
 	CODA_FIRMWARE_VERNUM(CODA_960, 2, 3, 10),
 	CODA_FIRMWARE_VERNUM(CODA_960, 3, 1, 1),
+	CODA_FIRMWARE_VERNUM(CODA980_PRODUCT_CODE, 3, 0, 1),
 };
 
 static bool coda_firmware_supported(u32 vernum)
@@ -954,7 +955,7 @@ static bool coda_firmware_supported(u32 vernum)
 int coda_check_firmware(struct coda_dev *dev)
 {
 	u16 expected_product, product, major, minor, release;
-	u32 data;
+	u32 data, vernum;
 	int ret;
 
 	ret = coda_enable_clocks(dev);
@@ -980,10 +981,14 @@ int coda_check_firmware(struct coda_dev *dev)
 
 	/* Check we are compatible with the loaded firmware */
 	data = coda_read(dev, CODA_CMD_FIRMWARE_VERNUM);
-	product = CODA_FIRMWARE_PRODUCT(data);
+	if (dev->devtype->firmware_product_reg)
+		product = coda_read(dev, dev->devtype->firmware_product_reg);
+	else
+		product = CODA_FIRMWARE_PRODUCT(data);
 	major = CODA_FIRMWARE_MAJOR(data);
 	minor = CODA_FIRMWARE_MINOR(data);
 	release = CODA_FIRMWARE_RELEASE(data);
+	vernum = CODA_FIRMWARE_VERNUM(product, major, minor, release);
 
 	coda_disable_clocks(dev);
 
@@ -999,7 +1004,7 @@ int coda_check_firmware(struct coda_dev *dev)
 	v4l2_info(&dev->v4l2_dev, "Initialized %s.\n",
 		  coda_product_name(product));
 
-	if (coda_firmware_supported(data)) {
+	if (coda_firmware_supported(vernum)) {
 		v4l2_info(&dev->v4l2_dev, "Firmware version: %u.%u.%u\n",
 			  major, minor, release);
 	} else {
diff --git a/drivers/media/platform/chips-media/coda/coda-common.c b/drivers/media/platform/chips-media/coda/coda-common.c
index e61e1d2a7..e002c5d68 100644
--- a/drivers/media/platform/chips-media/coda/coda-common.c
+++ b/drivers/media/platform/chips-media/coda/coda-common.c
@@ -3344,6 +3344,7 @@ static const struct coda_devtype sg2002_coda980_devdata = {
 	/* The SG2002 firmware implements the Coda9 register command ABI. */
 	.product		= CODA_960,
 	.firmware_product	= CODA980_PRODUCT_CODE,
+	.firmware_product_reg	= CODA9_GDI_PRODUCT_CODE,
 	.codecs			= coda9_codecs,
 	.num_codecs		= ARRAY_SIZE(coda9_codecs),
 	.vdevs			= sg2002_coda980_video_devices,
diff --git a/drivers/media/platform/chips-media/coda/coda.h b/drivers/media/platform/chips-media/coda/coda.h
index d1882779d..82e9e0c9a 100644
--- a/drivers/media/platform/chips-media/coda/coda.h
+++ b/drivers/media/platform/chips-media/coda/coda.h
@@ -64,6 +64,8 @@ struct coda_devtype {
 	enum coda_product	product;
 	/* Optional product value returned by the firmware query command. */
 	u16			firmware_product;
+	/* Optional register containing a product code separate from VERNUM. */
+	u32			firmware_product_reg;
 	const struct coda_codec	*codecs;
 	unsigned int		num_codecs;
 	const struct coda_video_device **vdevs;
diff --git a/drivers/media/platform/chips-media/coda/coda_regs.h b/drivers/media/platform/chips-media/coda/coda_regs.h
index db81a904c..3caebf848 100644
--- a/drivers/media/platform/chips-media/coda/coda_regs.h
+++ b/drivers/media/platform/chips-media/coda/coda_regs.h
@@ -451,6 +451,7 @@
 #define CODA9_CMD_FIRMWARE_CODE_REV		0x1c4
 
 #define CODA9_GDMA_BASE				0x1000
+#define CODA9_GDI_PRODUCT_CODE			(CODA9_GDMA_BASE + 0x044)
 #define CODA9_GDI_CONTROL			(CODA9_GDMA_BASE + 0x034)
 #define CODA9_GDI_PIC_INIT_HOST			(CODA9_GDMA_BASE + 0x038)
 #define CODA9_GDI_STATUS			(CODA9_GDMA_BASE + 0x080)
-- 
2.54.0

