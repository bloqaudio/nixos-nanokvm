+	struct clk_hw *park_parent;
+	unsigned long park_rate, flags;
+	unsigned int lane, park_lane;
+	u32 reg, park_val;
 
-	if (!rate || !parent_rate)
-		return -EINVAL;
+	if (mmux->retune_state != CV1800_MMUX_RUNNING)
