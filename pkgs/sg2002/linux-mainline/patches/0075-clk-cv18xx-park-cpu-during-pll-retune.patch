-	if (ret < 0)
-		return ret;
-	val = ret;
-	if (val == div_helper_get_clockdiv(&mmux->common, div))
-		return 0;
+	park_lane = !lane;
+	park_div = &mmux->div[park_lane];
+	park_mux = &mmux->mux[park_lane];
 
 	/*
