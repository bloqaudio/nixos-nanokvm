 		ret = devm_clk_hw_register(dev, hw);
 		if (ret) {
 			dev_err(dev, "Couldn't register clock %d - %s\n",
@@ -1482,6 +1486,19 @@
 		}
 	}
 
+	/*
+	 * MPLL feeds nothing but the CPU muxes, so it is the one PLL whose
